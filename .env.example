# Copia este archivo a ".env" (en la raiz del proyecto) y completa tus
# propios valores. El ".env" real NUNCA se versiona (ver .gitignore).

# --- Backend / Streamlit: conexion a PostgreSQL -----------------------------
# Debe coincidir con las credenciales de postgres_db (ver docker-compose.yml
# o tu servidor Postgres real).
DATABASE_URL=postgresql+psycopg://gestion_docente_app:contrasena@localhost:5432/gestion_docente

# --- Backend (API): JWT -----------------------------------------------------
# Genera una clave propia, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esta-clave-por-una-generada-con-secrets.token_hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- docker-compose.yml: credenciales del contenedor de Postgres ------------
# (Deben coincidir con el usuario/contrasena/bd usados en DATABASE_URL arriba.)
# Usa un usuario/contrasena/bd EXCLUSIVOS de este proyecto -- nunca un
# usuario generico ("admin") compartido con otros proyectos que corran en
# la misma maquina o el mismo servidor Postgres (ver docs/DESPLIEGUE_VPS.md,
# seccion 3, sobre aislar cada proyecto por base de datos y usuario propio).
POSTGRES_USER=gestion_docente_app
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=gestion_docente

# --- docker-compose.yml: pgAdmin (opcional) ---------------------------------
PGADMIN_EMAIL=admin@tu-dominio.test
PGADMIN_PASSWORD=cambia-esta-contrasena

# --- Correo saliente (aviso al Director/Secretario/Docente cuando la -------
# Secretaria del Programa aprueba una entrega). Si se deja vacío, el sistema
# sigue funcionando: la aprobación se guarda igual, solo no se envía el
# correo (se registra en el log). Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=tu-correo@gmail.com, SMTP_PASSWORD=una "contraseña
# de aplicación" (no la contraseña normal de la cuenta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@tu-dominio.test
SMTP_USE_TLS=true

# --- Recuperacion de contrasena: URL base del frontend para armar el ------
# enlace que se envia por correo (React en dev: http://localhost:5173; en
# produccion, el dominio publico del frontend).
FRONTEND_URL=http://localhost:5173

# URL publica de la app Streamlit, usada para armar el enlace de
# recuperacion de contrasena cuando la solicitud se hizo desde Streamlit.
STREAMLIT_URL=http://localhost:8501

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv-*/
venv/
*.egg-info/
.pytest_cache/

# Credenciales y configuracion local (nunca versionar)
.env

# Salidas temporales generadas por la app en tiempo de ejecucion
__salida_temp_*.xlsx
__informe_temp_*.pdf
~$*.xlsx

# Documentos institucionales reales (datos del docente, no de ejemplo)
documentos/*.xlsx
!documentos/.gitkeep

# Entregas documentales de los docentes (listas de asistencia, notas
# firmadas, informes -- datos reales y sensibles, nunca de ejemplo)
entregas_docentes/

# Repositorio de silabos y programas de asignatura (archivos reales)
repositorio_asignaturas/

# Formatos institucionales por programa academico (archivos reales)
formatos_institucionales/

# Frontend (Node / Vite)
frontend/node_modules/
frontend/dist/
frontend/.env.local
npm-debug.log*
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Herramientas de asistente / IDE (config local, no del proyecto)
.claude/
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db
